{
  "name": "remult-admin",
  "version": "0.0.11",
  "license": "MIT",
  "type": "module",
  "contributors": [
    {
      "name": "Noam Honig",
      "email": "noam.honig@gmail.com"
    }
  ],
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsx src/misc/build.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "release": "npm run build && npm run patch-versions && tsx src/misc/copy.ts && cd dist && npm publish --public && cd ..",
    "patch-versions": " FOR /F %i in ('npm version patch -m \"release %s\"') DO git push origin %i",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "codemirror": "6.0.2",
    "express": "^4.21.1",
    "happy-dom": "^21.0.4",
    "rollup-plugin-visualizer": "^7.1.3",
    "svelte": "5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "tslib": "^2.6.3",
    "uuid": "^8.3.2"
  }
}
